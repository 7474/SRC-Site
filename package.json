{
  "name": "src-site",
  "private": true,
  "description": "SRC#Web を組み込んだ SRC シナリオの投稿・配布ポータル（Cloudflare Workers）",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/workers",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "aws4fetch": "1.0.20",
    "hono": "4.13.14",
    "jose": "6.2.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.8",
    "@cloudflare/workers-types": "5.20261023.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.153.0"
  }
}
